# LLM Configuration Template
# Note: You can configure LLM settings directly in the Web UI (recommended)
# or use this file for default values

# LLM provider
# Options: ollama, groq
# default: ollama
LLM_PROVIDER=groq

# Ollama config (for local LLM)
# Ollama model name (default: qwen3-coder:30b)
OLLAMA_MODEL=qwen3-coder:30b
# Ollama address (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Groq config (for cloud LLM)
# IMPORTANT: Configure your API key directly in the Web UI for better security
# Available models: openai/gpt-oss-120b, qwen/qwen3-32b, meta-llama/llama-4-maverick-17b-128e-instruct
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

